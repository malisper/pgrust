# ---------------------------------------------------------------------------
# hosts.env — host inventory for the benchmark environment.
#
# PUBLIC-RELEASE NOTE: every value marked CHANGE-ME below was a concrete
# host/instance identifier in the original audit environment (since torn
# down). Provision your own three boxes (shapes documented per section),
# fill these in, and `source hosts.env` before running any runner script.
# ---------------------------------------------------------------------------

# --- ClickBench box --------------------------------------------------------
# c8g.4xlarge (16 vCPU / 32 GB), AL2023 arm64.
#
# TWO volumes, and which one holds the data matters to the score:
#   /dev/xvda  vol-CHANGEME-root  gp3 500 GiB, 3000 IOPS, 125 MB/s  -> /
#              OS only. Off-reference: measured ~146 MB/s sequential read.
#   /dev/sdf   vol-CHANGEME-ref  gp2 500 GiB, 1500 IOPS            -> /data2
#              REFERENCE storage, and what ClickBench's published c8g.4xlarge
#              rows use. Measured ~347 MB/s. It carries a loaded, verified copy
#              of the bank but is NOT in use until you run
#              ./use-reference-storage.sh -- see the README block at the top.
#              DeleteOnTermination=false, so it OUTLIVES the instance;
#              teardown.sh deletes it explicitly (~$50/mo if left behind).
#
# PGDATA_CB below is the AS-DELIVERED datadir: the off-reference gp3 one.
# use-reference-storage.sh rewrites the rig's copy of this when you opt in.
# Benchmarking as-delivered costs ~12 points of combined score vs our published
# figures, all of it on the cold and load axes. That is expected, disclosed, and
# not your error.
export PGDATA_CB=/data/clickbench/pgdata
export CB_REF_VOLUME=vol-CHANGEME-ref
export CB_ROOT_VOLUME=vol-CHANGEME-root
export CB_HOST=CHANGE-ME              # public IP/hostname of your clickbench box
export CB_PRIVATE=CHANGE-ME           # private (VPC) IP of your clickbench box
export CB_INSTANCE_ID=CHANGE-ME       # EC2 instance id of your clickbench box

# --- OLTP server -----------------------------------------------------------
# i8g.xlarge (4 vCPU / 32 GB / 872.6 GB instance-store NVMe), AL2023 arm64.
# This is the shape of record: it matches PlanetScale's published "M-320"
# baseline server (4 vCPU / 32 GB / 937 GB local NVMe, Graviton-class + NVMe).
# All datadirs live on the NVMe at /data.  INSTANCE STORE IS EPHEMERAL — a
# stop/start of this instance destroys every dataset on /data.  Reboot is safe;
# stop is not.
export OLTP_SERVER_HOST=CHANGE-ME     # public IP/hostname of your oltp-server box
export OLTP_SERVER_PRIVATE=CHANGE-ME  # private (VPC) IP of your oltp-server box
export OLTP_SERVER_INSTANCE_ID=CHANGE-ME

# --- OLTP client (the load driver) -----------------------------------------
# c8g.2xlarge (8 vCPU / 16 GB), AL2023 arm64.  Dedicated driver box: the
# methodology requires the client to be a separate machine from the server, in
# the same region/AZ, so that client CPU never steals from the engine under
# test.  Run run-oltp-ro.sh and run-oltp-rw.sh FROM HERE.
export OLTP_CLIENT_HOST=CHANGE-ME     # public IP/hostname of your oltp-client box
export OLTP_CLIENT_PRIVATE=CHANGE-ME  # private (VPC) IP of your oltp-client box
export OLTP_CLIENT_INSTANCE_ID=CHANGE-ME

# --- How the client reaches the server -------------------------------------
# Port 5432 is open ONLY between members of the audit security group, never to
# the internet.  Always use the PRIVATE address for database traffic.
export PGHOST_BENCH=$OLTP_SERVER_PRIVATE
export PGPORT_BENCH=5432
export PGUSER_BENCH=postgres
export PGDATABASE_BENCH=bench

# --- Login -----------------------------------------------------------------
export AUDIT_USER=CHANGE-ME           # ssh user with passwordless sudo on all three boxes

# --- Where results land ----------------------------------------------------
export RESULTS_DIR="${RESULTS_DIR:-$HOME/results}"

# --- Artifact under audit --------------------------------------------------
# The pgrust release candidate.  See README.md "What exactly is being audited"
# and, importantly, "Binary provenance and the PGO disclosure".
export PGRUST_BIN=/opt/pgrust/bin/postgres
export PGRUST_SHA256=70a473036bd78c299bc23ee63f2d16b65d790f19d4f00c8eab05b02cf68869b5
export PGRUST_GATED_SHA=3e6cb16b1d22f6c754451dcc1f82c007934732fb
export PGRUST_RC_BRANCH=release/rc1-audit-v2
export PGRUST_RC_TIP=bdfddd5394

# --- the FROZEN RC: the binary of record --------------------------------------
# Not preinstalled. Install it yourself:
#   ./update-binary.sh rc1-sinkfix --replace-default
# It contains the GL-SINKCRASH-1/2 fixes for the MIN/MAX(text) crash that the
# preinstalled binary (PGRUST_SHA256 above) still has.
export PGRUST_FROZEN_SHA=94f498ea6cd62097c9eaa1cb6118c113c5082612
export PGRUST_FROZEN_SHA256=3efae04bdbdbae5b1e4619eca7678bbf872b3b5bf14543746e54610148b18c69
export PGRUST_FROZEN_NAME=rc1-sinkfix

# --- Mode 2: a binary you build yourself ----------------------------------
# build-pgo.sh writes here (clickbench box). deploy-binary.sh copies it to the
# oltp-server and installs it alongside the shipped artifact, never over it.
#
#   built here      : $PGRUST_BUILD_BIN
#   installed there : /opt/pgrust/bin/postgres.auditor-build
#   referred to as  : --binary auditor-build       (OLTP runners)
#                     --binary $PGRUST_BUILD_BIN   (run-clickbench.sh)
#
# There is deliberately NO expected hash for your build: it is yours, and its
# provenance is the manifest beside it, not a value we published in advance.
export PGRUST_BUILD_DIR=$HOME/audit/build
export PGRUST_BUILD_BIN=$HOME/audit/build/postgres
export PGRUST_BUILD_MANIFEST=$HOME/audit/build/build-manifest.txt
export PGRUST_SRC_DEFAULT=$HOME/audit/build/src
export PGRUST_DEPLOYED_NAME=auditor-build

# --- Security group / EIP allocations (for teardown) -----------------------
export AUDIT_SG=CHANGE-ME             # security group id (teardown.sh)
export AUDIT_EIP_CB=CHANGE-ME         # Elastic IP allocation ids (teardown.sh)
export AUDIT_EIP_OLTP_SERVER=CHANGE-ME
export AUDIT_EIP_OLTP_CLIENT=CHANGE-ME
export AUDIT_KEYPAIR=CHANGE-ME        # EC2 key pair name (teardown.sh)
export AUDIT_REGION=us-east-2
