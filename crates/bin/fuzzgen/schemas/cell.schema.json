{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgrust.dev/schemas/sitediff/cell.schema.json",
  "title": "Cell",
  "description": "cell.json: the environment cell, content-addressed by cell_id = sha256(canonical JSON: keys sorted, no whitespace). Plan v2 section 6. Rust twin: contracts.rs Cell.",
  "type": "object",
  "additionalProperties": false,
  "required": ["oracle", "b_build", "initdb", "conf", "logging", "hba", "server_flags", "topology", "fs_fixtures", "host", "faults"],
  "properties": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "variants"],
      "properties": {
        "version": { "type": "string", "const": "REL_18_6", "description": "Any other minor is refused at boot." },
        "variants": { "type": "array", "items": { "type": "string", "enum": ["gcov", "inj", "ssl", "xml", "icu", "openssl"] } }
      }
    },
    "b_build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "features"],
      "properties": {
        "profile": { "type": "string", "enum": ["dev", "dev-server", "release"] },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "initdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "locale", "checksums"],
      "properties": {
        "encoding": { "type": "string", "enum": ["UTF8", "SQL_ASCII", "LATIN1"] },
        "locale": { "type": "string" },
        "checksums": { "type": "boolean" }
      }
    },
    "conf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "gucs", "guc_pin", "cmm"],
      "properties": {
        "profile": { "type": ["string", "null"], "description": "configprofiles.sh profile name, or null for cfgsampler-drawn GUCs." },
        "gucs": { "type": "object", "additionalProperties": { "type": "string" } },
        "guc_pin": { "type": "boolean", "description": "Keep the runner.rs C-parity/datetime pins." },
        "cmm": { "type": ["string", "null"], "enum": ["notice", "log", "debug1", "debug2", null] }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "prefix", "timezone", "min_messages", "csvlog", "jsonlog"],
      "properties": {
        "mode": { "type": "string", "enum": ["stderr", "collector", "witness"] },
        "prefix": { "type": "string" },
        "timezone": { "type": "string" },
        "min_messages": { "type": "string" },
        "csvlog": { "type": "boolean" },
        "jsonlog": { "type": "boolean" }
      }
    },
    "hba": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "responders", "rules"],
      "properties": {
        "method": { "type": "string", "enum": ["trust", "password", "md5", "scram-sha-256", "radius", "ldap", "reject"] },
        "responders": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "server_flags": { "type": "array", "items": { "type": "string" } },
    "topology": {
      "type": "string",
      "enum": ["single", "fdw-loop", "logical-live", "standby", "twosession", "admission", "memwatchdog", "janitor", "corrupt-page"]
    },
    "fs_fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string", "enum": ["extension_control_path", "libdir", "tablespace", "file", "tsearch_data"] },
          "path": { "type": "string" },
          "variant": { "type": ["string", "null"] }
        }
      }
    },
    "host": { "type": "string", "enum": ["linux", "macos"] },
    "faults": { "type": "string", "enum": ["none", "antithesis"] }
  }
}
