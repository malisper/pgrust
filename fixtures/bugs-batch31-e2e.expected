-- bugs/batch-31-backend-commands-tablecmds: expected captured from C 18.6.
-- fp-commands-tablecmds-p1#1: CREATE TABLE .. PARTITION OF checks USAGE on
-- every inherited column type (BuildDescForRelation, tablecmds.c:1425).
CREATE ROLE b31_u;
CREATE SCHEMA b31_s AUTHORIZATION b31_u;
CREATE DOMAIN b31_d AS integer;
SET ROLE b31_u;
CREATE TABLE b31_s.p (k integer, v b31_d) PARTITION BY RANGE (k);
RESET ROLE;
REVOKE USAGE ON DOMAIN b31_d FROM PUBLIC;
SET ROLE b31_u;
CREATE TABLE b31_s.c PARTITION OF b31_s.p FOR VALUES FROM (0) TO (10);
ERROR:  permission denied for type b31_d
RESET ROLE;
GRANT USAGE ON DOMAIN b31_d TO b31_u;
SET ROLE b31_u;
CREATE TABLE b31_s.c PARTITION OF b31_s.p FOR VALUES FROM (0) TO (10);
RESET ROLE;
SELECT relname FROM pg_class WHERE relnamespace = 'b31_s'::regnamespace ORDER BY 1;
 relname 
---------
 c
 p
(2 rows)

DROP SCHEMA b31_s CASCADE;
NOTICE:  drop cascades to table b31_s.p
DROP DOMAIN b31_d;
DROP ROLE b31_u;
-- fp-fmgr-fmgr#2: ALTER TABLE .. INHERIT decompiles a compressed conbin
-- (pg_get_expr through fmgr needs a result context for the detoast).
CREATE TABLE b31_pa (a text);
CREATE TABLE b31_ch (a text);
DO $$ BEGIN
  EXECUTE format('ALTER TABLE b31_pa ADD CONSTRAINT big CHECK (a <> %L)', repeat('x', 10000));
  EXECUTE format('ALTER TABLE b31_ch ADD CONSTRAINT big CHECK (a <> %L)', repeat('x', 10000));
END $$;
SELECT pg_column_compression(conbin) FROM pg_constraint WHERE conrelid = 'b31_pa'::regclass;
 pg_column_compression 
-----------------------
 pglz
(1 row)

ALTER TABLE b31_ch INHERIT b31_pa;
SELECT conname, coninhcount FROM pg_constraint WHERE conrelid = 'b31_ch'::regclass;
 conname | coninhcount 
---------+-------------
 big     |           1
(1 row)

DROP TABLE b31_ch, b31_pa;
