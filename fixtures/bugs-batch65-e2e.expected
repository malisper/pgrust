-- bugs/batch-65-backend-catalog: catalog fixes, expected captured from C 18.6
-- except where marked hand-verified.
\set VERBOSITY verbose
-- fp-commands-policy#1: policy.c:1229 get_relation_policy_oid passes the
-- name to nameeq unchanged; a 64-byte name never matches a 63-byte policy.
CREATE TABLE b65_t(i int);
DO $$BEGIN EXECUTE format('CREATE POLICY %I ON b65_t USING (true)', repeat('p',63)); END$$;
SELECT * FROM pg_get_object_address('policy', ARRAY['public','b65_t',repeat('p',64)], ARRAY[]::text[]);
ERROR:  42704: policy "pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp" for table "b65_t" does not exist
SELECT * FROM pg_get_object_address('policy', ARRAY['public','b65_t',repeat('p',65)], ARRAY[]::text[]);
ERROR:  42704: policy "ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp" for table "b65_t" does not exist
SELECT classid, objsubid, objid = (SELECT oid FROM pg_policy WHERE polname = repeat('p',63)) AS same FROM pg_get_object_address('policy', ARRAY['public','b65_t',repeat('p',63)], ARRAY[]::text[]);
 classid | objsubid | same 
---------+----------+------
    3256 |        0 | t
(1 row)

DROP TABLE b65_t;
-- fp-catalog-pg_type#1 (pg-also-bug, hand-verified): pg_type.c:973 cuts the
-- range name at 52 bytes inside a multibyte character; pgrust clips on a
-- character boundary so the multirange name stays valid UTF-8.
DO $$ BEGIN EXECUTE format('CREATE TYPE %I AS RANGE (subtype = int4)', repeat('a', 51) || 'é'); END $$;
SELECT typname, octet_length(typname::text) AS bytes, length(typname::text) AS chars FROM pg_type WHERE typname LIKE 'aaaaaaaaaa%' ORDER BY 1;
                            typname                             | bytes | chars 
----------------------------------------------------------------+-------+-------
 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_multirange |    62 |    62
 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaé           |    53 |    52
(2 rows)

DO $$ BEGIN EXECUTE format('DROP TYPE %I', repeat('a', 51) || 'é'); END $$;
-- a range name that keeps "range" is rewritten, not truncated (unchanged).
CREATE TYPE b65_myrange AS RANGE (subtype = int4);
SELECT typname FROM pg_type WHERE typname LIKE 'b65_my%' ORDER BY 1;
     typname      
------------------
 b65_mymultirange
 b65_myrange
(2 rows)

DROP TYPE b65_myrange;
