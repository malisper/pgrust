-- Two-binary differential corpus for the 2026-09-13 bug-inventory batch
-- batch-141-backend-executor-execmain (C 18.6 oracle vs pgrust). Each leg is
-- one row of the batch (scripts/executor-execmain-b141-e2e.sh).
\set VERBOSITY verbose
CREATE DATABASE b141e2e TEMPLATE template0 ENCODING 'UTF8';
\c b141e2e
\set VERBOSITY verbose
-- fp-executor-execAmi#1: an indirectly correlated hashed SubPlan is built
-- once per outer parameter change; the rescan of its own tree must not mark
-- it stale (the volatile b141_vf ran 18 times instead of 3).
CREATE TABLE b141_a(k int); INSERT INTO b141_a VALUES (1),(2);
CREATE TABLE b141_b(k int, y int); INSERT INTO b141_b VALUES (1,1),(1,2),(1,3),(2,1),(2,2),(2,3);
CREATE TABLE b141_c(k int, y int); INSERT INTO b141_c VALUES (1,1),(1,2),(2,2);
CREATE FUNCTION b141_vf(i int) RETURNS int LANGUAGE plpgsql VOLATILE AS $$ BEGIN RAISE NOTICE 'b141_vf(%)', i; RETURN i; END $$;
SET enable_hashjoin = off; SET enable_mergejoin = off;
SELECT a.k, (SELECT count(*) FROM b141_b b WHERE b.k = a.k AND (b.y IN (SELECT b141_vf(c.y) FROM b141_c c WHERE c.k = a.k) OR b.y IS NULL)) FROM b141_a a ORDER BY 1;
NOTICE:  00000: b141_vf(1)
NOTICE:  00000: b141_vf(2)
NOTICE:  00000: b141_vf(2)
 k | count 
---+-------
 1 |     2
 2 |     1
(2 rows)

RESET enable_hashjoin; RESET enable_mergejoin;
-- fp-executor-execParallel#1: only the worker's root statement skips its
-- junk filter; a nested SELECT INTO record inside a PARALLEL SAFE function
-- run by a worker drops its ORDER BY junk column as in C.
CREATE TABLE b141_p AS SELECT i AS a, (i*7)%11 AS b FROM generate_series(1,2000) i;
ANALYZE b141_p;
CREATE FUNCTION b141_pf(k int) RETURNS text LANGUAGE plpgsql PARALLEL SAFE STABLE AS $$
DECLARE r record; BEGIN SELECT a INTO r FROM b141_p WHERE a = k ORDER BY b; RETURN row_to_json(r)::text; END $$;
SET parallel_setup_cost = 0; SET parallel_tuple_cost = 0; SET min_parallel_table_scan_size = 0;
SET max_parallel_workers_per_gather = 2; SET parallel_leader_participation = off;
EXPLAIN (COSTS OFF) SELECT b141_pf(a) FROM b141_p WHERE a % 500 = 0;
            QUERY PLAN             
-----------------------------------
 Gather
   Workers Planned: 2
   ->  Parallel Seq Scan on b141_p
         Filter: ((a % 500) = 0)
(4 rows)

SELECT b141_pf(a) FROM b141_p WHERE a % 500 = 0 ORDER BY 1;
  b141_pf   
------------
 {"a":1000}
 {"a":1500}
 {"a":2000}
 {"a":500}
(4 rows)

RESET parallel_setup_cost; RESET parallel_tuple_cost; RESET min_parallel_table_scan_size;
RESET max_parallel_workers_per_gather; RESET parallel_leader_participation;
-- fp-executor-execAmi#3: IndexSupportsBackwardScan asks the AM handler, so
-- an index of a CREATE ACCESS METHOD ... HANDLER bthandler AM gives an
-- undeclared cursor implicit SCROLL like btree.
CREATE ACCESS METHOD b141_btree TYPE INDEX HANDLER bthandler;
CREATE OPERATOR CLASS b141_int4_ops DEFAULT FOR TYPE int4 USING b141_btree AS
  OPERATOR 1 <, OPERATOR 2 <=, OPERATOR 3 =, OPERATOR 4 >=, OPERATOR 5 >, FUNCTION 1 btint4cmp(int4,int4);
CREATE TABLE b141_i (a int);
INSERT INTO b141_i SELECT i FROM generate_series(1,100) i;
CREATE INDEX b141_i_idx ON b141_i USING b141_btree (a);
ANALYZE b141_i;
SET enable_seqscan = off; SET enable_bitmapscan = off;
BEGIN;
EXPLAIN (COSTS OFF) SELECT a FROM b141_i WHERE a > 90;
                 QUERY PLAN                 
--------------------------------------------
 Index Only Scan using b141_i_idx on b141_i
   Index Cond: (a > 90)
(2 rows)

DECLARE b141_c CURSOR FOR SELECT a FROM b141_i WHERE a > 90;
FETCH 3 FROM b141_c;
 a  
----
 91
 92
 93
(3 rows)

FETCH BACKWARD 2 FROM b141_c;
 a  
----
 92
 91
(2 rows)

ROLLBACK;
RESET enable_seqscan; RESET enable_bitmapscan;
