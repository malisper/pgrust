ERROR:  0A000: unit "timezone" not supported for type interval
SELECT extract(bogus from interval '1 day');
ERROR:  22023: unit "bogus" not recognized for type interval
SELECT date_trunc('hour', interval '2 years 5 mons 10 days 12:30:45.678');
           date_trunc            
---------------------------------
