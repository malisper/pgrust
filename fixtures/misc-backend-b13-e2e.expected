-- bugs/batch-13-misc-backend: C-vs-pgrust parity for the fixes in
-- catalog/{objectaddress,pg_proc,catalog_indexing}, partitioning/partbounds
-- and rewrite/rewriteManip. Expected file captured from C 18.6
-- (scripts/regress-diff.sh --capture).
\set VERBOSITY verbose
-- objectaddress: getObjectDescription appends the raw language name
CREATE LANGUAGE "b13 lang" HANDLER plpgsql_call_handler;
SELECT pg_describe_object('pg_language'::regclass, oid, 0) FROM pg_language WHERE lanname = 'b13 lang';
 pg_describe_object 
--------------------
 language b13 lang
(1 row)

SET quote_all_identifiers = on;
SELECT pg_describe_object('pg_language'::regclass, oid, 0) FROM pg_language WHERE lanname = 'sql';
 pg_describe_object 
--------------------
 language sql
(1 row)

RESET quote_all_identifiers;
DROP LANGUAGE "b13 lang";
