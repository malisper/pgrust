DROP FUNCTION b13_f;
-- partbounds: a hash support function returning NULL is fmgr's XX000
CREATE FUNCTION b13_nullhash(int, bigint) RETURNS bigint LANGUAGE sql AS 'SELECT NULL::bigint';
CREATE OPERATOR CLASS b13_null_hash_ops FOR TYPE int USING hash AS
  OPERATOR 1 =, FUNCTION 1 hashint4(int), FUNCTION 2 b13_nullhash(int, bigint);
CREATE TABLE b13_hp(a int) PARTITION BY HASH (a b13_null_hash_ops);
CREATE TABLE b13_hp_0 PARTITION OF b13_hp FOR VALUES WITH (MODULUS 1, REMAINDER 0);
DO $$ BEGIN
  INSERT INTO b13_hp VALUES (1);
EXCEPTION WHEN OTHERS THEN
  RAISE NOTICE '% %', SQLSTATE, regexp_replace(SQLERRM, '[0-9]+', 'N');
END $$;
NOTICE:  00000: XX000 function N returned NULL
DO $$ BEGIN
  PERFORM satisfies_hash_partition('b13_hp'::regclass, 1, 0, 1);
EXCEPTION WHEN OTHERS THEN
  RAISE NOTICE '% %', SQLSTATE, regexp_replace(SQLERRM, '[0-9]+', 'N');
END $$;
NOTICE:  00000: XX000 function N returned NULL
DROP TABLE b13_hp;
DROP OPERATOR CLASS b13_null_hash_ops USING hash;
DROP FUNCTION b13_nullhash;
-- indexing: a summarizing (BRIN) index on a catalog takes the TU_Summarizing arm
SET allow_system_table_mods = on;
CREATE TABLE b13_t(a integer);
CREATE INDEX b13_attribute_brin ON pg_catalog.pg_attribute USING brin (attstattarget);
ALTER TABLE b13_t ALTER COLUMN a SET STATISTICS 123;
ALTER TABLE b13_t ALTER COLUMN a SET STATISTICS 124;
ALTER TABLE b13_t ALTER COLUMN a SET STATISTICS 125;
SELECT attstattarget FROM pg_attribute WHERE attrelid = 'b13_t'::regclass AND attname = 'a';
 attstattarget 
---------------
           125
(1 row)

DROP INDEX pg_catalog.b13_attribute_brin;
DROP TABLE b13_t;
RESET allow_system_table_mods;
-- rewriteManip: SetVarReturningType descends into subqueries
CREATE TABLE b13_r(a int);
INSERT INTO b13_r VALUES (10);
CREATE VIEW b13_v AS SELECT b13_r.a, (SELECT s.a FROM (SELECT b13_r.a OFFSET 0) s) AS b FROM b13_r;
UPDATE b13_v SET a = 20 RETURNING old.a, new.a, old.b, new.b;
 a  | a  | b  | b  
----+----+----+----
 10 | 20 | 10 | 20
(1 row)

DROP VIEW b13_v;
DROP TABLE b13_r;
