SELECT 1 ORDER BY 1;
 ?column? 
----------
        1
(1 row)

SELECT 1 LIMIT 1;
 ?column? 
----------
        1
(1 row)

SELECT 1 LIMIT 0;
 ?column? 
----------
(0 rows)

SELECT 1 OFFSET 1;
 ?column? 
----------
(0 rows)

VALUES (3), (1), (2) ORDER BY 1;
 column1 
---------
       1
       2
       3
(3 rows)

VALUES (3), (1), (2) ORDER BY 1 DESC LIMIT 2;
 column1 
---------
       3
       2
(2 rows)

SELECT * FROM (VALUES (2, 'b'), (1, 'a')) AS v(n, s) ORDER BY n;
 n | s 
---+---
 1 | a
 2 | b
(2 rows)

-- ===== error surface [elog lane: SQLSTATE + message + cursor position parity] =====
SELECT nonesuch;
ERROR:  42703: column "nonesuch" does not exist
LINE 1: SELECT nonesuch;
               ^
SELECT 1 +;
ERROR:  42601: syntax error at or near ";"
LINE 1: SELECT 1 +;
                  ^
SELECT 1/0;
ERROR:  22012: division by zero
SELECT 'foo'::int4;
ERROR:  22P02: invalid input syntax for type integer: "foo"
LINE 1: SELECT 'foo'::int4;
               ^
SELECT ''::int4;
ERROR:  22P02: invalid input syntax for type integer: ""
LINE 1: SELECT ''::int4;
               ^
SELECT 2147483647::int4 + 1;
ERROR:  22003: integer out of range
SHOW no_such_parameter;
ERROR:  42704: unrecognized configuration parameter "no_such_parameter"
SET work_mem = 'bogus';
ERROR:  22023: invalid value for parameter "work_mem": "bogus"
-- REQUIRES: table
-- ===== point select / star / WHERE [heapam + seqscan executor; setup needs DML — gate with --skip-tables until INSERT lands] =====
CREATE TABLE regress_m1_t (id int4, val text);
INSERT INTO regress_m1_t VALUES (1, 'one'), (2, 'two'), (3, 'three');
SELECT * FROM regress_m1_t ORDER BY id;
 id |  val  
----+-------
  1 | one
  2 | two
  3 | three
(3 rows)

SELECT val FROM regress_m1_t WHERE id = 2;
 val 
-----
 two
(1 row)

SELECT id, val FROM regress_m1_t WHERE id > 1 ORDER BY id DESC;
 id |  val  
----+-------
  3 | three
  2 | two
(2 rows)

SELECT * FROM regress_m1_t WHERE id = 2 LIMIT 1;
 id | val 
----+-----
  2 | two
(1 row)

SELECT count(*) FROM regress_m1_t;
 count 
-------
     3
(1 row)

SELECT vall FROM regress_m1_t;
ERROR:  42703: column "vall" does not exist
LINE 1: SELECT vall FROM regress_m1_t;
               ^
HINT:  Perhaps you meant to reference the column "regress_m1_t.val".
SELECT * FROM no_such_table;
ERROR:  42P01: relation "no_such_table" does not exist
LINE 1: SELECT * FROM no_such_table;
                      ^
DROP TABLE regress_m1_t;
-- ===== jsonb core [adt_jsonb: in/out, JEntry tree, operators, cmp/hash] =====
SELECT '{"b": 2, "a": 1, "a": 3}'::jsonb;
      jsonb       
------------------
 {"a": 3, "b": 2}
(1 row)

SELECT '{"key": [1, 2.50, null, "x"], "nested": {"deep": [true, false]}}'::jsonb;
                              jsonb                               
------------------------------------------------------------------
 {"key": [1, 2.50, null, "x"], "nested": {"deep": [true, false]}}
(1 row)

SELECT '[1e2, 0.5, "\u00e9\ud83d\ude00", ""]'::jsonb;
         jsonb         
-----------------------
 [100, 0.5, "é😀", ""]
(1 row)

SELECT '-1.50'::jsonb::text;
 text  
-------
 -1.50
(1 row)

SELECT jsonb_typeof('{"a":1}'::jsonb), jsonb_typeof('[1]'::jsonb), jsonb_typeof('"s"'::jsonb), jsonb_typeof('1'::jsonb), jsonb_typeof('true'::jsonb), jsonb_typeof('null'::jsonb);
 jsonb_typeof | jsonb_typeof | jsonb_typeof | jsonb_typeof | jsonb_typeof | jsonb_typeof 
--------------+--------------+--------------+--------------+--------------+--------------
 object       | array        | string       | number       | boolean      | null
(1 row)

SELECT '{"a": {"b": [10, 20, {"c": "d"}]}}'::jsonb -> 'a';
          ?column?           
-----------------------------
 {"b": [10, 20, {"c": "d"}]}
(1 row)

SELECT '{"a": {"b": "c"}}'::jsonb ->> 'a';
  ?column?  
------------
 {"b": "c"}
(1 row)

SELECT '["x", 1.50, true]'::jsonb -> 1, '["x", 1.50, true]'::jsonb ->> -1;
 ?column? | ?column? 
----------+----------
 1.50     | true
(1 row)

SELECT '["x"]'::jsonb -> 5, '{"a":1}'::jsonb -> 'zz';
 ?column? | ?column? 
----------+----------
          | 
