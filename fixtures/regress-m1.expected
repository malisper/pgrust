CREATE TEMP TABLE b02_outfn(m1 macaddr8, m2 macaddr8, i1 inet, i2 inet, c1 cidr, c2 cidr, o1 oid, o2 oid, x1 xid, x2 xid, d1 cid, d2 cid);
