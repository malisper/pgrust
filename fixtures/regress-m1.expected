(1 row)

-- ===== SET/SHOW round-trips [guc lane: set_config_option / GetConfigOptionByName] =====
SHOW work_mem;
 work_mem 
----------
 4MB
(1 row)

SET work_mem = '8MB';
SHOW work_mem;
 work_mem 
----------
 8MB
(1 row)

RESET work_mem;
SHOW work_mem;
 work_mem 
----------
 4MB
(1 row)

SET datestyle = 'ISO, YMD';
SHOW datestyle;
 DateStyle 
-----------
 ISO, YMD
(1 row)

RESET datestyle;
SET search_path TO public;
SHOW search_path;
 search_path 
-------------
 public
(1 row)

BEGIN;
SET LOCAL work_mem = '16MB';
SHOW work_mem;
 work_mem 
----------
 16MB
(1 row)

COMMIT;
SHOW work_mem;
 work_mem 
----------
 4MB
(1 row)

-- ===== EXPLAIN [planner + commands/explain lane; costs pinned by C's cost model] =====
EXPLAIN (COSTS OFF) SELECT 1;
 QUERY PLAN 
------------
 Result
(1 row)

EXPLAIN SELECT 1;
                QUERY PLAN                
------------------------------------------
 Result  (cost=0.00..0.01 rows=1 width=4)
(1 row)

EXPLAIN (COSTS OFF) SELECT 1 + 2 AS three;
 QUERY PLAN 
------------
 Result
(1 row)

EXPLAIN (COSTS OFF) SELECT 1 ORDER BY 1;
 QUERY PLAN 
------------
 Result
(1 row)

EXPLAIN (COSTS OFF) SELECT 1 LIMIT 1;
  QUERY PLAN  
--------------
 Limit
   ->  Result
(2 rows)

EXPLAIN (VERBOSE, COSTS OFF) SELECT 1 AS one;
 QUERY PLAN  
-------------
 Result
   Output: 1
(2 rows)

-- ===== EXPLAIN ANALYZE [instrument lane; TIMING/SUMMARY/BUFFERS OFF for determinism] =====
EXPLAIN (ANALYZE, TIMING OFF, SUMMARY OFF, BUFFERS OFF) SELECT 1;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Result  (cost=0.00..0.01 rows=1 width=4) (actual rows=1.00 loops=1)
(1 row)

EXPLAIN (ANALYZE, TIMING OFF, SUMMARY OFF, BUFFERS OFF, COSTS OFF) SELECT 1;
            QUERY PLAN             
-----------------------------------
 Result (actual rows=1.00 loops=1)
(1 row)

EXPLAIN (ANALYZE, TIMING OFF, SUMMARY OFF, BUFFERS OFF, COSTS OFF) SELECT 1 LIMIT 0;
            QUERY PLAN            
----------------------------------
 Limit (actual rows=0.00 loops=1)
   ->  Result (never executed)
(2 rows)

-- ===== transactions [xact lane: BEGIN/COMMIT/ROLLBACK/SAVEPOINT state machine] =====
BEGIN;
SELECT 1;
 ?column? 
----------
        1
(1 row)

COMMIT;
BEGIN;
SELECT 2;
 ?column? 
----------
        2
(1 row)

ROLLBACK;
BEGIN;
SAVEPOINT sp1;
SELECT 3;
 ?column? 
----------
        3
(1 row)

ROLLBACK TO SAVEPOINT sp1;
RELEASE SAVEPOINT sp1;
COMMIT;
COMMIT;
WARNING:  25P01: there is no transaction in progress
BEGIN;
SELECT 1/0;
ERROR:  22012: division by zero
SELECT 1;
ERROR:  25P02: current transaction is aborted, commands ignored until end of transaction block
ROLLBACK;
BEGIN;
SAVEPOINT sp2;
SELECT 1/0;
ERROR:  22012: division by zero
ROLLBACK TO SAVEPOINT sp2;
SELECT 42;
 ?column? 
----------
       42
(1 row)

COMMIT;
ROLLBACK TO SAVEPOINT nope;
ERROR:  25P01: ROLLBACK TO SAVEPOINT can only be used in transaction blocks
-- ===== PREPARE/EXECUTE/DEALLOCATE [commands/prepare + plancache lane] =====
PREPARE regress_m1_p1 AS SELECT 1;
EXECUTE regress_m1_p1;
 ?column? 
----------
        1
(1 row)

PREPARE regress_m1_p2(int) AS SELECT $1 + 1;
EXECUTE regress_m1_p2(41);
 ?column? 
----------
       42
(1 row)

EXECUTE regress_m1_p2('not_an_int');
ERROR:  22P02: invalid input syntax for type integer: "not_an_int"
LINE 1: EXECUTE regress_m1_p2('not_an_int');
                              ^
PREPARE regress_m1_p1 AS SELECT 2;
ERROR:  42P05: prepared statement "regress_m1_p1" already exists
DEALLOCATE regress_m1_p2;
EXECUTE regress_m1_p2(1);
ERROR:  26000: prepared statement "regress_m1_p2" does not exist
DEALLOCATE regress_m1_p1;
DEALLOCATE ALL;
