SELECT (xpath('100000000000000000000', '<r/>'::xml))[1]::text, (xpath('1000000000000000', '<r/>'::xml))[1]::text, (xpath('1 div 3', '<r/>'::xml))[1]::text, (xpath('1 div 0', '<r/>'::xml))[1]::text, (xpath('-1 div 0', '<r/>'::xml))[1]::text;
