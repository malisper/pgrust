-- tz-surface differential corpus: TimeZone GUC, AT TIME ZONE, EXTRACT,
-- date_trunc(+zone), now-family, make_timestamptz. Zones pinned to UTC,
-- America/New_York (both 2025 DST edges), Asia/Kolkata (+05:30).
-- Run via scripts/regress-diff.sh --sql fixtures/tz-e2e.sql.
\set VERBOSITY verbose
\pset pager off
-- ===== TimeZone GUC forms =====
SET TIME ZONE 'UTC';
SHOW timezone;
 TimeZone 
----------
 UTC
(1 row)

SHOW TIME ZONE;
 TimeZone 
----------
 UTC
(1 row)

SELECT '2025-03-09 06:30:00+00'::timestamptz;
         timestamptz          
------------------------------
 Sun Mar 09 06:30:00 2025 UTC
(1 row)

SET TIME ZONE 'America/New_York';
SHOW timezone;
     TimeZone     
------------------
 America/New_York
(1 row)

SELECT '2025-03-09 06:30:00+00'::timestamptz;
         timestamptz          
------------------------------
 Sun Mar 09 01:30:00 2025 EST
(1 row)

SELECT '2025-03-09 02:30:00'::timestamptz;
         timestamptz          
------------------------------
 Sun Mar 09 03:30:00 2025 EDT
(1 row)

SELECT '2025-11-02 01:30:00'::timestamptz;
         timestamptz          
------------------------------
 Sun Nov 02 01:30:00 2025 EST
(1 row)

SELECT '2025-07-04 12:00:00'::timestamptz;
         timestamptz          
------------------------------
 Fri Jul 04 12:00:00 2025 EDT
(1 row)

SELECT '2025-01-04 12:00:00'::timestamptz;
         timestamptz          
------------------------------
 Sat Jan 04 12:00:00 2025 EST
(1 row)

SET timezone = 'Asia/Kolkata';
SHOW timezone;
   TimeZone   
--------------
 Asia/Kolkata
(1 row)

SELECT '2025-01-01 00:00:00+00'::timestamptz;
         timestamptz          
------------------------------
 Wed Jan 01 05:30:00 2025 IST
(1 row)

SELECT '2025-01-01 00:00:00'::timestamptz;
         timestamptz          
------------------------------
 Wed Jan 01 00:00:00 2025 IST
(1 row)

SET timezone TO 'America/New_York';
SHOW timezone;
     TimeZone     
------------------
 America/New_York
(1 row)

SET TIME ZONE -7;
SHOW timezone;
 TimeZone 
----------
 <-07>+07
(1 row)

SELECT '2025-01-01 00:00:00+00'::timestamptz;
         timestamptz          
------------------------------
 Tue Dec 31 17:00:00 2024 -07
(1 row)

SET TIME ZONE 7.5;
SHOW timezone;
    TimeZone    
----------------
 <+07:30>-07:30
(1 row)

SELECT '2025-01-01 00:00:00+00'::timestamptz;
           timestamptz           
---------------------------------
 Wed Jan 01 07:30:00 2025 +07:30
(1 row)

SET TIME ZONE DEFAULT;
RESET timezone;
RESET TIME ZONE;
SET TIME ZONE 'invalid/zone';
ERROR:  22023: invalid value for parameter "TimeZone": "invalid/zone"
SET timezone = 'Not/AZone';
ERROR:  22023: invalid value for parameter "TimeZone": "Not/AZone"
SET TIME ZONE 'UTC';
-- ===== AT TIME ZONE both directions across DST edges =====
