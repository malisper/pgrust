         ->  Foreign Scan on public.fpb1 fpb_1
               Output: fpb_1.id, fpb_1.w
               Remote SQL: SELECT id, w FROM public.fpb1_base
         ->  Materialize
               Output: fpa_1.id, fpa_1.v
               ->  Seq Scan on public.fpa1 fpa_1
                     Output: fpa_1.id, fpa_1.v
                     Filter: (fpa_1.v = ANY ('{a4,a150}'::text[]))
   ->  Nested Loop
         Output: fpa_2.id, fpa_2.v, fpb_2.id, fpb_2.w
         Join Filter: (fpb_2.id = fpa_2.id)
         ->  Foreign Scan on public.fpb2 fpb_2
               Output: fpb_2.id, fpb_2.w
               Remote SQL: SELECT id, w FROM public.fpb2_base
         ->  Materialize
               Output: fpa_2.id, fpa_2.v
               ->  Seq Scan on public.fpa2 fpa_2
                     Output: fpa_2.id, fpa_2.v
                     Filter: (fpa_2.v = ANY ('{a4,a150}'::text[]))
(23 rows)

SELECT * FROM fpa JOIN fpb ON fpa.id = fpb.id WHERE fpa.v IN ('a4', 'a150') ORDER BY 1;
 id  |  v   | id  |  w   
-----+------+-----+------
   4 | a4   |   4 | b4
 150 | a150 | 150 | b150
(2 rows)

