  2 |   2
(2 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT id FROM wa WHERE id < 3) s LEFT JOIN LATERAL (SELECT wb.y FROM wb WHERE wb.id = s.id) t ON true;
                   QUERY PLAN                    
-------------------------------------------------
 Hash Right Join
   Hash Cond: (wb.id = wa.id)
   ->  Seq Scan on wb
   ->  Hash
         ->  Index Only Scan using wa_pkey on wa
               Index Cond: (id < 3)
(6 rows)

