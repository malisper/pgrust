-- ===== src/backend/optimizer/plan/setrefs.c:set_join_references|NodeTag (Var) =====
SET enable_hashjoin = off; SET enable_mergejoin = off;
EXPLAIN (VERBOSE, COSTS OFF) SELECT wa.t FROM wb, wa WHERE wa.id = wb.id AND wb.id < 3;
                    QUERY PLAN                    
--------------------------------------------------
 Nested Loop
   Output: wa.t
   Inner Unique: true
   ->  Index Only Scan using wb_pkey on public.wb
         Output: wb.id
         Index Cond: (wb.id < 3)
   ->  Index Scan using wa_pkey on public.wa
         Output: wa.id, wa.x, wa.b, wa.v, wa.t
         Index Cond: (wa.id = wb.id)
(9 rows)

SELECT wa.t FROM wb, wa WHERE wa.id = wb.id AND wb.id < 3 ORDER BY 1;
 t  
----
 t1
 t2
(2 rows)

EXPLAIN (VERBOSE, COSTS OFF) SELECT wa.t, wb.y FROM wb JOIN wa ON wa.x = wb.y + 1 WHERE wb.id = 3;
                  QUERY PLAN                   
-----------------------------------------------
 Nested Loop
   Output: wa.t, wb.y
   ->  Index Scan using wb_pkey on public.wb
         Output: wb.id, wb.y
         Index Cond: (wb.id = 3)
   ->  Bitmap Heap Scan on public.wa
         Output: wa.id, wa.x, wa.b, wa.v, wa.t
         Recheck Cond: (wa.x = (wb.y + 1))
         ->  Bitmap Index Scan on wa_x
               Index Cond: (wa.x = (wb.y + 1))
(10 rows)

SELECT wa.t, wb.y FROM wb JOIN wa ON wa.x = wb.y + 1 WHERE wb.id = 3 ORDER BY 1 LIMIT 2;
