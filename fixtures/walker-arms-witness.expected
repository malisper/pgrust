-- ===== src/backend/statistics/mcv.c:mcv_get_match_bitmap|NodeTag (RestrictInfo/Var) =====
CREATE STATISTICS wa_mcv (mcv) ON x, b FROM wa;
ANALYZE wa;
EXPLAIN SELECT * FROM wa WHERE x = 1 AND b;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Bitmap Heap Scan on wa  (cost=4.90..13.15 rows=1 width=16)
   Recheck Cond: (x = 1)
   Filter: b
   ->  Bitmap Index Scan on wa_x  (cost=0.00..4.90 rows=100 width=0)
         Index Cond: (x = 1)
(5 rows)

EXPLAIN SELECT * FROM wa WHERE x = 2 AND NOT b;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Bitmap Heap Scan on wa  (cost=4.90..13.15 rows=1 width=16)
   Recheck Cond: (x = 2)
   Filter: (NOT b)
   ->  Bitmap Index Scan on wa_x  (cost=0.00..4.90 rows=100 width=0)
         Index Cond: (x = 2)
(5 rows)

EXPLAIN SELECT * FROM wa WHERE x = 1 AND b IS TRUE;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Bitmap Heap Scan on wa  (cost=4.91..13.16 rows=50 width=16)
   Recheck Cond: (x = 1)
   Filter: (b IS TRUE)
   ->  Bitmap Index Scan on wa_x  (cost=0.00..4.90 rows=100 width=0)
         Index Cond: (x = 1)
(5 rows)

EXPLAIN SELECT * FROM wa WHERE (x = 1 OR x = 2) AND b;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Bitmap Heap Scan on wa  (cost=5.68..15.68 rows=100 width=16)
   Recheck Cond: ((x = 1) OR (x = 2))
   Filter: b
   ->  Bitmap Index Scan on wa_x  (cost=0.00..5.65 rows=200 width=0)
         Index Cond: (x = ANY ('{1,2}'::integer[]))
(5 rows)

EXPLAIN SELECT * FROM wa WHERE x IN (1, 3) AND b = false;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Bitmap Heap Scan on wa  (cost=5.70..15.20 rows=200 width=16)
   Recheck Cond: (x = ANY ('{1,3}'::integer[]))
   Filter: (NOT b)
   ->  Bitmap Index Scan on wa_x  (cost=0.00..5.65 rows=200 width=0)
         Index Cond: (x = ANY ('{1,3}'::integer[]))
(5 rows)

