 fn clean_encoding_name(key: &[u8], buf: &mut [u8; NAMEDATALEN]) -> usize {
     let mut n = 0;
     for &b in key {
         if b.is_ascii_alphanumeric() {
             buf[n] = b.to_ascii_lowercase();
-            n += 1;
