 /// [`pg_mbstrlen_with_len`] parameterized by encoding (parser callers thread
 /// the server encoding explicitly).
 pub fn pg_encoding_mbstrlen_with_len(encoding: pg_enc, mbstr: &[u8]) -> PgResult<i32> {
