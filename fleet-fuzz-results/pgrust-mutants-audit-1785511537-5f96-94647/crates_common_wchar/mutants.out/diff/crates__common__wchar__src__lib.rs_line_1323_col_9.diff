 #[inline(always)]
 fn utf8_second_byte_legal(b0: u8, a: u8) -> bool {
     match b0 {
         0xe0 => (0xa0..=0xbf).contains(&a),
-        0xed => (0x80..=0x9f).contains(&a),
+         /* ~ changed by cargo-mutants ~ */
         0xf0 => (0x90..=0xbf).contains(&a),
         0xf4 => (0x80..=0x8f).contains(&a),
         _ => (0x80..=0xbf).contains(&a),
     }
 }
 
