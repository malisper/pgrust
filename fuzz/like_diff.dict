# libFuzzer dictionary for like_diff: LIKE/ILIKE wildcard + escape grammar
# tokens for the adt/like differential (like.c + like_match.c stampings).
# Seeds in fuzz/corpus/like_diff/ mirror these shapes.
# arm selectors
"\x00"
"\x01"
"\x02"
"\x03"
"\x04"
"\x05"
"\x06"
"\x07"
"\x08"
"\x09"
"\x0a"
"\x0b"
# wildcard / escape kernel tokens
pct="%"
us="_"
esc="\\"
esc_pct="\\%"
esc_us="\\_"
esc_esc="\\\\"
pct_run="%%%"
pct_us="%_"
us_pct="_%"
us_run="___"
pct_us_ladder="%_%_%"
trailing_esc="abc\\"
pct_trailing_esc="%\\"
esc_before_scan="%\\a"
# literal fragments the scan-for-first-byte loop keys on
lit_ab="ab"
lit_abc="abc"
lit_pct_ab="%ab"
lit_a_pct_ab="a%ab"
name_pg="pg_class"
name_esc="pg\\_%"
mixed_case="AbC"
upper="PG_Class"
# multibyte chars (wildcard-boundary shapes)
utf8_2byte="\xc3\xa9"
utf8_3byte="\xe2\x82\xac"
utf8_4byte="\xf0\x9f\x90\x89"
utf8_2byte_us="\xc3\xa9_"
us_utf8_2byte="_\xc3\xa9"
pct_utf8="%\xc3\xa9"
utf8_lead_alone="\xc3"
utf8_cont_alone="\xa9"
latin1_e_acute="\xe9"
highbyte_ff="\xff"
nul_byte="\x00"
# like_escape escape-string shapes
esc_hash="#"
esc_hash_pct="#%"
esc_hash_us="#_"
esc_two_char="xy"
esc_doubled="##"
# hardening pass (2026-07-31): direct kernel arm selectors 12/13/14
# (sb_match_text / utf8_match_text / sb_imatch_text)
"\x0c"
"\x0d"
"\x0e"
# ABORT-tristate witnesses (%-scan exhausts the text)
abort_scan="%zz"
abort_tail="ab_"
