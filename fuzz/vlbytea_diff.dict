# vlbytea_diff dictionary (scaffolded by fuzz/scaffold.py; tokens filled for
# the byteain input language — hex form, escape form, octal edges — from the
# vendored strings/bytea regress literals plus the whitespace set
# hex_decode_safe skips. CmpLog + dictionary is day-one for parser-shaped
# targets (fuzzuproof-crate skill).)
# byteain hex form
"\\x"
"\\x0aFF"
"\\x 0a"
"\\xDeAdBeEf"
"\\x5c"
"\\x0"
"\\xzz"
# byteain escape form + octal edges
"\\\\"
"\\000"
"\\001"
"\\377"
"\\134"
"\\400"
"\\778"
"\\07"
"\\q"
# hex whitespace set (skipped by hex_decode_safe)
" "
"\t"
"\n"
"\r"
# escape-output landmarks
"\\x01"
"\\177"
# truncated multibyte lead bytes (22021 arm) and bad continuations
"\xc3"
"\xe2\x82"
"\xf0\x9f"
"\x80"
# arm selectors
"\x00"
"\x01"
"\x02"
"\x03"
"\x04"
"\x05"
"\x06"
"\x07"
"\x08"
"\x09"
"\x0a"
"\x0b"
"\x0c"
"\x0d"
"\x0e"
"\x0f"
"\x10"
"\x11"
"\x12"
"\x13"
"\x14"
"\x15"
"\x16"
"\x17"
"\x18"
"\x19"
"\x1a"
"\x1b"
"\x1c"
"\x1d"
"\x1e"
"\x1f"
