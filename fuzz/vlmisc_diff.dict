# vlmisc_diff dictionary (scaffolded by fuzz/scaffold.py; filled by the
# vlmisc_diff lane). CmpLog + dictionary is day-one for parser-shaped
# targets (fuzzuproof-crate skill). Tokens: unistr escape forms,
# normalization form names (both casings), surrogate hex bands,
# split-identifier punctuation, levenshtein cost/boundary shapes.
# arm selectors
"\x00"
"\x01"
"\x02"
"\x03"
"\x04"
"\x05"
"\x06"
"\x07"
"\x08"
"\x09"
"\x0a"
"\x0b"
"\x0c"
"\x0d"
"\x0e"
# unistr escape introducers and full escapes
"\\"
"\\\\"
"\\u"
"\\+"
"\\U"
"\\0041"
"\\u0041"
"\\+000041"
"\\U00000041"
"\\+010000"
"\\+10FFFF"
"\\+110000"
"\\0000"
# surrogate halves (pair, dangling, reversed)
"\\d800"
"\\d83d"
"\\dbff"
"\\dc00"
"\\de04"
"\\dfff"
# normalization form names (pg_strcasecmp is ASCII-case-blind)
"NFC"
"NFD"
"NFKC"
"NFKD"
"nfc"
"nfd"
"nfkc"
"nfkd"
"NfKc"
# multibyte UTF-8: 2/3/4-byte chars, combining acute, Hangul jamo,
# unassigned U+0378, compat ligature U+FB01
"\xc3\xa9"
"\xe2\x82\xac"
"\xf0\x9f\x90\x89"
"\xcc\x81"
"\xe1\x84\x80"
"\xe1\x85\xa1"
"\xea\xb0\x81"
"\xcd\xb8"
"\xef\xac\x81"
"\xf4\x8f\xbf\xbf"
# split-identifier punctuation shapes
","
"."
"\""
"\"\""
"\",\""
", "
" , "
"pg_catalog"
# joined-list sentinel (comparison image)
"\x1f"
