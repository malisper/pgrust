step expl: 
 EXPLAIN (COSTS OFF)
 WITH requested AS (SELECT 1 AS id),
 lock_ids AS (
   SELECT id FROM requested
   UNION
   SELECT t.parent_id
     FROM epq_unique t JOIN requested r USING (id)
    WHERE t.parent_id IS NOT NULL
 )
 SELECT t.id, t.value
   FROM epq_unique t JOIN lock_ids USING (id)
  ORDER BY t.id
  FOR UPDATE OF t;

